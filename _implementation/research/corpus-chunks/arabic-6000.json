[{"ayah":"89:8","text":"ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَـٰدِ","citation_url":null},{"ayah":"89:9","text":"وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ","citation_url":null},{"ayah":"89:10","text":"وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ","citation_url":null},{"ayah":"89:11","text":"ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَـٰدِ","citation_url":null},{"ayah":"89:12","text":"فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ","citation_url":null},{"ayah":"89:13","text":"فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ","citation_url":null},{"ayah":"89:14","text":"إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ","citation_url":null},{"ayah":"89:15","text":"فَأَمَّا ٱلْإِنسَـٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ","citation_url":null},{"ayah":"89:16","text":"وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَـٰنَنِ","citation_url":null},{"ayah":"89:17","text":"كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ","citation_url":null},{"ayah":"89:18","text":"وَلَا تَحَـٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","citation_url":null},{"ayah":"89:19","text":"وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا","citation_url":null},{"ayah":"89:20","text":"وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا","citation_url":null},{"ayah":"89:21","text":"كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا","citation_url":null},{"ayah":"89:22","text":"وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا","citation_url":null},{"ayah":"89:23","text":"وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَـٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ","citation_url":null},{"ayah":"89:24","text":"يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى","citation_url":null},{"ayah":"89:25","text":"فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ","citation_url":null},{"ayah":"89:26","text":"وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ","citation_url":null},{"ayah":"89:27","text":"يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ","citation_url":null},{"ayah":"89:28","text":"ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً","citation_url":null},