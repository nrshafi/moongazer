[{"ayah":"107:4","text":"فَوَيْلٌ لِّلْمُصَلِّينَ","citation_url":null},{"ayah":"107:5","text":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","citation_url":null},{"ayah":"107:6","text":"ٱلَّذِينَ هُمْ يُرَآءُونَ","citation_url":null},{"ayah":"107:7","text":"وَيَمْنَعُونَ ٱلْمَاعُونَ","citation_url":null},{"ayah":"108:1","text":"إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ","citation_url":null},{"ayah":"108:2","text":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","citation_url":null},{"ayah":"108:3","text":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","citation_url":null},{"ayah":"109:1","text":"قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ","citation_url":null},{"ayah":"109:2","text":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","citation_url":null},{"ayah":"109:3","text":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","citation_url":null},{"ayah":"109:4","text":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ","citation_url":null},{"ayah":"109:5","text":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","citation_url":null},{"ayah":"109:6","text":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","citation_url":null},{"ayah":"110:1","text":"إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ","citation_url":null},{"ayah":"110:2","text":"وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًا","citation_url":null},{"ayah":"110:3","text":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا","citation_url":null},{"ayah":"111:1","text":"تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ","citation_url":null},{"ayah":"111:2","text":"مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ","citation_url":null},{"ayah":"111:3","text":"سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ","citation_url":null},{"ayah":"111:4","text":"وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ","citation_url":null},{"ayah":"111:5","text":"فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ","citation_url":null},{"ayah":"112:1","text":"قُلْ هُوَ ٱللَّهُ أَحَدٌ","citation_url":null},{"ayah":"112:2","text":"ٱللَّهُ ٱلصَّمَدُ","citation_url":null},{"ayah":"112:3","text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","citation_url":null},{"ayah":"112:4","text":"وَلَمْ يَكُن لَّهُۥ ك