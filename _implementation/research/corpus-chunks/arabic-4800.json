":"55:19","text":"مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ","citation_url":null},{"ayah":"55:20","text":"بَيْنَهُمَا بَرْزَخٌ لَّا يَبْغِيَانِ","citation_url":null},{"ayah":"55:21","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","citation_url":null},{"ayah":"55:22","text":"يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ","citation_url":null},{"ayah":"55:23","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","citation_url":null},{"ayah":"55:24","text":"وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَـٰمِ","citation_url":null},{"ayah":"55:25","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","citation_url":null},{"ayah":"55:26","text":"كُلُّ مَنْ عَلَيْهَا فَانٍ","citation_url":null},{"ayah":"55:27","text":"وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ","citation_url":null},{"ayah":"55:28","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","citation_url":null},{"ayah":"55:29","text":"يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍ","citation_url":null},{"ayah":"55:30","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","citation_url":null},{"ayah":"55:31","text":"سَنَفْرُغُ لَكُمْ أَيُّهَ ٱلثَّقَلَانِ","citation_url":null},{"ayah":"55:32","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","citation_url":null},{"ayah":"55:33","text":"يَـٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ إِنِ ٱسْتَطَعْتُمْ أَن تَنفُذُوا۟ مِنْ أَقْطَارِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ فَٱنفُذُوا۟ ۚ لَا تَنفُذُونَ إِلَّا بِسُلْطَـٰنٍ","citation_url":null},{"ayah":"55:34","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","citation_url":null},{"ayah":"55:35","text":"يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّن نَّارٍ وَنُحَاسٌ فَلَا تَنتَصِرَانِ","citation_url":null},{"ayah":"55:36","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","citation_url":null},{"ayah":"55:37","text":"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتْ وَرْدَةً كَٱلدِّهَانِ","citation_url":null},{"ayah":"55:38","text":"فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","citation_url":null},{"ayah":"55:39",