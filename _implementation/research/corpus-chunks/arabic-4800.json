[{"ayah":"53:17","text":"مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ","citation_url":null},{"ayah":"53:18","text":"لَقَدْ رَأَىٰ مِنْ ءَايَـٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ","citation_url":null},{"ayah":"53:19","text":"أَفَرَءَيْتُمُ ٱللَّـٰتَ وَٱلْعُزَّىٰ","citation_url":null},{"ayah":"53:20","text":"وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ","citation_url":null},{"ayah":"53:21","text":"أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ","citation_url":null},{"ayah":"53:22","text":"تِلْكَ إِذًا قِسْمَةٌ ضِيزَىٰٓ","citation_url":null},{"ayah":"53:23","text":"إِنْ هِىَ إِلَّآ أَسْمَآءٌ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَـٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ","citation_url":null},{"ayah":"53:24","text":"أَمْ لِلْإِنسَـٰنِ مَا تَمَنَّىٰ","citation_url":null},{"ayah":"53:25","text":"فَلِلَّهِ ٱلْـَٔاخِرَةُ وَٱلْأُولَىٰ","citation_url":null},{"ayah":"53:26","text":"۞ وَكَم مِّن مَّلَكٍ فِى ٱلسَّمَـٰوَٰتِ لَا تُغْنِى شَفَـٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ","citation_url":null},{"ayah":"53:27","text":"إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْـَٔاخِرَةِ لَيُسَمُّونَ ٱلْمَلَـٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ","citation_url":null},{"ayah":"53:28","text":"وَمَا لَهُم بِهِۦ مِنْ عِلْمٍ ۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ ۖ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًٔا","citation_url":null},{"ayah":"53:29","text":"فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا ٱلْحَيَوٰةَ ٱلدُّنْيَا","citation_url":null},{"ayah":"53:30","text":"ذَٰلِكَ مَبْلَغُهُم مِّنَ ٱلْعِلْمِ ۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ ٱهْتَدَىٰ","citation_url":null},{"ayah":"53:31","text":"وَلِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَـٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى","citation_url":null},{"ayah":"53:32","text":"ٱلَّذِينَ يَجْتَنِبُونَ كَبَـٰٓئِرَ ٱلْإِثْ