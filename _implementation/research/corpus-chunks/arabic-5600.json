:"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ","citation_url":null},{"ayah":"77:44","text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ","citation_url":null},{"ayah":"77:45","text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","citation_url":null},{"ayah":"77:46","text":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ","citation_url":null},{"ayah":"77:47","text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","citation_url":null},{"ayah":"77:48","text":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ","citation_url":null},{"ayah":"77:49","text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","citation_url":null},{"ayah":"77:50","text":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ","citation_url":null},{"ayah":"78:1","text":"عَمَّ يَتَسَآءَلُونَ","citation_url":null},{"ayah":"78:2","text":"عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ","citation_url":null},{"ayah":"78:3","text":"ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ","citation_url":null},{"ayah":"78:4","text":"كَلَّا سَيَعْلَمُونَ","citation_url":null},{"ayah":"78:5","text":"ثُمَّ كَلَّا سَيَعْلَمُونَ","citation_url":null},{"ayah":"78:6","text":"أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا","citation_url":null},{"ayah":"78:7","text":"وَٱلْجِبَالَ أَوْتَادًا","citation_url":null},{"ayah":"78:8","text":"وَخَلَقْنَـٰكُمْ أَزْوَٰجًا","citation_url":null},{"ayah":"78:9","text":"وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا","citation_url":null},{"ayah":"78:10","text":"وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا","citation_url":null},{"ayah":"78:11","text":"وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا","citation_url":null},{"ayah":"78:12","text":"وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا","citation_url":null},{"ayah":"78:13","text":"وَجَعَلْنَا سِرَاجًا وَهَّاجًا","citation_url":null},{"ayah":"78:14","text":"وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا","citation_url":null},{"ayah":"78:15","text":"لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا","citation_url":null},{"ayah":"78:16","text":"وَجَنَّـٰتٍ أَلْفَافًا","citation_url":null},{"ayah":"78:17","text":"إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَـٰتًا","citation_url":null},