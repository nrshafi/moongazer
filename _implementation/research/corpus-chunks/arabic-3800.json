[{"ayah":"37:13","text":"وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ","citation_url":null},{"ayah":"37:14","text":"وَإِذَا رَأَوْا۟ ءَايَةً يَسْتَسْخِرُونَ","citation_url":null},{"ayah":"37:15","text":"وَقَالُوٓا۟ إِنْ هَـٰذَآ إِلَّا سِحْرٌ مُّبِينٌ","citation_url":null},{"ayah":"37:16","text":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ","citation_url":null},{"ayah":"37:17","text":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","citation_url":null},{"ayah":"37:18","text":"قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ","citation_url":null},{"ayah":"37:19","text":"فَإِنَّمَا هِىَ زَجْرَةٌ وَٰحِدَةٌ فَإِذَا هُمْ يَنظُرُونَ","citation_url":null},{"ayah":"37:20","text":"وَقَالُوا۟ يَـٰوَيْلَنَا هَـٰذَا يَوْمُ ٱلدِّينِ","citation_url":null},{"ayah":"37:21","text":"هَـٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","citation_url":null},{"ayah":"37:22","text":"۞ ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ","citation_url":null},{"ayah":"37:23","text":"مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ","citation_url":null},{"ayah":"37:24","text":"وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ","citation_url":null},{"ayah":"37:25","text":"مَا لَكُمْ لَا تَنَاصَرُونَ","citation_url":null},{"ayah":"37:26","text":"بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ","citation_url":null},{"ayah":"37:27","text":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ","citation_url":null},{"ayah":"37:28","text":"قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ","citation_url":null},{"ayah":"37:29","text":"قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ","citation_url":null},{"ayah":"37:30","text":"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَـٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًا طَـٰغِينَ","citation_url":null},{"ayah":"37:31","text":"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ","citation_url":null},{"ayah":"37:32","text":"فَأَغْوَيْنَـٰكُمْ إِنَّا كُنَّا غَـٰوِينَ","citation_url":null},{"ayah":"37:33","text":"فَإِنَّهُمْ يَوْمَئِذٍ فِى ٱلْعَذَابِ مُشْتَرِكُونَ","citation_url":null},{"ayah":"37:34","text":"إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ","citation_url":null},{"ayah":"37:35","text":"إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَـٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ","citation_url":null},{"ayah":"37:36","text":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍ مَّجْنُونٍۭ","citation_url":null},{"ayah":"37:37","text":"بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ","citation_url":null},{"ayah":"37:38","text":"إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ","citation_url":null},{"ayah":"37:39","text":"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ","citation_url":null},{"ayah":"37:40","text":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","citation_url":null},{"ayah":"37:41","text":"أُو۟لَـٰٓئِكَ لَهُمْ رِزْقٌ مَّعْلُومٌ","citation_url":null},{"ayah":"37:42","text":"فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ","citation_url":null},{"ayah":"37:43","text":"فِى جَنَّـٰتِ ٱلنَّعِيمِ","citation_url":null},{"ayah":"37:44","text":"عَلَىٰ سُرُرٍ مُّتَقَـٰبِلِينَ","citation_url":null},{"ayah":"37:45","text":"يُطَافُ عَلَيْهِم بِكَأْسٍ مِّن مَّعِينٍۭ","citation_url":null},{"ayah":"37:46","text":"بَيْضَآءَ لَذَّةٍ لِّلشَّـٰرِبِينَ","citation_url":null},{"ayah":"37:47","text":"لَا فِيهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنزَفُونَ","citation_url":null},{"ayah":"37:48","text":"وَعِندَهُمْ قَـٰصِرَٰتُ ٱلطَّرْفِ عِينٌ","citation_url":null},{"ayah":"37:49","text":"كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ","citation_url":null},{"ayah":"37:50","text":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَآءَلُونَ","citation_url":null},{"ayah":"37:51","text":"قَالَ قَآئِلٌ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌ","citation_url":null},{"ayah":"37:52","text":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ","citation_url":null},{"ayah":"37:53","text":"أَءِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَدِينُونَ","citation_url":null},{"ayah":"37:54","text":"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ","citation_url":null},{"ayah":"37:55","text":"فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ","citation_url":null},{"ayah":"37:56","text":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ","citation_url":null},{"ayah":"37:57","text":"وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ","citation_url":null},{"ayah":"37:58","text":"أَفَمَا نَحْنُ بِمَيِّتِينَ","citation_url":null},{"ayah":"37:59","text":"إِلَّا مَوْتَتَنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُعَذَّبِينَ","citation_url":null},{"ayah":"37:60","text":"إِنَّ هَـٰذَا لَهُوَ ٱلْفَوْزُ ٱلْعَظِيمُ","citation_url":null},{"ayah":"37:61","text":"لِمِثْلِ هَـٰذَا فَلْيَعْمَلِ ٱلْعَـٰمِلُونَ","citation_url":null},{"ayah":"37:62","text":"أَذَٰلِكَ خَيْرٌ نُّزُلًا أَمْ شَجَرَةُ ٱلزَّقُّومِ","citation_url":null},{"ayah":"37:63","text":"إِنَّا جَعَلْنَـٰهَا فِتْنَةً لِّلظَّـٰلِمِينَ","citation_url":null},{"ayah":"37:64","text":"إِنَّهَا شَجَرَةٌ تَخْرُجُ فِىٓ أَصْلِ ٱلْجَحِيمِ","citation_url":null},{"ayah":"37:65","text":"طَلْعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَـٰطِينِ","citation_url":null},{"ayah":"37:66","text":"فَإِنَّهُمْ لَـَٔاكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ","citation_url":null},{"ayah":"37:67","text":"ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيمٍ","citation_url":null},{"ayah":"37:68","text":"ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَى ٱلْجَحِيمِ","citation_url":null},{"ayah":"37:69","text":"إِنَّهُمْ أَلْفَوْا۟ ءَابَآءَهُمْ ضَآلِّينَ","citation_url":null},{"ayah":"37:70","text":"فَهُمْ عَلَىٰٓ ءَاثَـٰرِهِمْ يُهْرَعُونَ","citation_url":null},{"ayah":"37:71","text":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ ٱلْأَوَّلِينَ","citation_url":null},{"ayah":"37:72","text":"وَلَقَدْ أَرْسَلْنَا فِيهِم مُّنذِرِينَ","citation_url":null},{"ayah":"37:73","text":"فَٱنظُرْ كَيْفَ كَانَ عَـٰقِبَةُ ٱلْمُنذَرِينَ","citation_url":null},{"ayah":"37:74","text":"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ","citation_url":null},{"ayah":"37:75","text":"وَلَقَدْ نَادَىٰنَا نُوحٌ فَلَنِعْمَ ٱلْمُجِيبُونَ","citation_url":null},{"ayah":"37:76","text":"وَنَجَّيْنَـٰهُ وَأَهْلَهُۥ مِنَ ٱلْكَرْبِ ٱلْعَظِيمِ","citation_url":null},{"ayah":"37:77","text":"وَجَعَلْنَ