[{"ayah":"81:1","text":"إِذَا ٱلشَّمْسُ كُوِّرَتْ","citation_url":null},{"ayah":"81:2","text":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","citation_url":null},{"ayah":"81:3","text":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","citation_url":null},{"ayah":"81:4","text":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","citation_url":null},{"ayah":"81:5","text":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","citation_url":null},{"ayah":"81:6","text":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","citation_url":null},{"ayah":"81:7","text":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","citation_url":null},{"ayah":"81:8","text":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","citation_url":null},{"ayah":"81:9","text":"بِأَىِّ ذَنۢبٍ قُتِلَتْ","citation_url":null},{"ayah":"81:10","text":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","citation_url":null},{"ayah":"81:11","text":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","citation_url":null},{"ayah":"81:12","text":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","citation_url":null},{"ayah":"81:13","text":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","citation_url":null},{"ayah":"81:14","text":"عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ","citation_url":null},{"ayah":"81:15","text":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","citation_url":null},{"ayah":"81:16","text":"ٱلْجَوَارِ ٱلْكُنَّسِ","citation_url":null},{"ayah":"81:17","text":"وَٱلَّيْلِ إِذَا عَسْعَسَ","citation_url":null},{"ayah":"81:18","text":"وَٱلصُّبْحِ إِذَا تَنَفَّسَ","citation_url":null},{"ayah":"81:19","text":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ","citation_url":null},{"ayah":"81:20","text":"ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ","citation_url":null},{"ayah":"81:21","text":"مُّطَاعٍ ثَمَّ أَمِينٍ","citation_url":null},{"ayah":"81:22","text":"وَمَا صَاحِبُكُم بِمَجْنُونٍ","citation_url":null},{"ayah":"81:23","text":"وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ","citation_url":null},{"ayah":"81:24","text":"وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ","citation_url":null},{"ayah":"81:25","text":"وَمَا هُوَ بِقَوْلِ شَيْطَـٰنٍ رَّجِيمٍ","citation_url":null},{"ayah":"81:26","text":"فَأَيْنَ تَذْهَبُونَ","citation_url":null},{"ayah":"81:27","text":"إِنْ هُوَ إِلَّ