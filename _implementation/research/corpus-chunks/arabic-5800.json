":"83:3","text":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","citation_url":null},{"ayah":"83:4","text":"أَلَا يَظُنُّ أُو۟لَـٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","citation_url":null},{"ayah":"83:5","text":"لِيَوْمٍ عَظِيمٍ","citation_url":null},{"ayah":"83:6","text":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَـٰلَمِينَ","citation_url":null},{"ayah":"83:7","text":"كَلَّآ إِنَّ كِتَـٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍ","citation_url":null},{"ayah":"83:8","text":"وَمَآ أَدْرَىٰكَ مَا سِجِّينٌ","citation_url":null},{"ayah":"83:9","text":"كِتَـٰبٌ مَّرْقُومٌ","citation_url":null},{"ayah":"83:10","text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ","citation_url":null},{"ayah":"83:11","text":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ","citation_url":null},{"ayah":"83:12","text":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ","citation_url":null},{"ayah":"83:13","text":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَـٰتُنَا قَالَ أَسَـٰطِيرُ ٱلْأَوَّلِينَ","citation_url":null},{"ayah":"83:14","text":"كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ","citation_url":null},{"ayah":"83:15","text":"كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍ لَّمَحْجُوبُونَ","citation_url":null},{"ayah":"83:16","text":"ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ","citation_url":null},{"ayah":"83:17","text":"ثُمَّ يُقَالُ هَـٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","citation_url":null},{"ayah":"83:18","text":"كَلَّآ إِنَّ كِتَـٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ","citation_url":null},{"ayah":"83:19","text":"وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ","citation_url":null},{"ayah":"83:20","text":"كِتَـٰبٌ مَّرْقُومٌ","citation_url":null},{"ayah":"83:21","text":"يَشْهَدُهُ ٱلْمُقَرَّبُونَ","citation_url":null},{"ayah":"83:22","text":"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ","citation_url":null},{"ayah":"83:23","text":"عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ","citation_url":null},{"ayah":"83:24","text":"تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ","citation_url":null},{"ayah":"83:25","text":"يُسْقَوْنَ مِن رَّحِيقٍ مَّخْتُومٍ","citation_url"