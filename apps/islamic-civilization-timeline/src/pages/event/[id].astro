---
import Shell from '../../layouts/Shell.astro';
import References from '../../components/References.astro';
import {events} from '../../data/content.json';
export function getStaticPaths(){return events.map(event=>({params:{id:event.id},props:{event}}));}
const {event}=Astro.props;
const related=events.filter(item=>item.id!==event.id&&(item.region===event.region||item.topic===event.topic)).slice(0,3);
---
<Shell title={event.title}>
 <a class="back-link" href="/">← All historical records</a>
 <section class="intro"><span class="eyebrow">{event.region} · {event.topic}</span> <h1 class="editorial">{event.title}</h1> <p>{event.date} · {event.place}</p></section>
 <div class="dossier"><section class="panel panel-body"><h2>The historical record</h2><p>{event.summary}</p><div class="reading-note"><h3>Keep the date’s precision</h3><p>{event.note}</p></div><p class="micro">Century and half-century bounds are editorial filtering aids. They do not turn a broad source period into an exact date.</p><div class="reading-actions"><button class="button secondary" data-save={event.id} aria-pressed="false">Save for later</button> <button class="button secondary" data-print>Print record</button></div></section> <aside class="panel panel-body"><h2>Across the same collection</h2><p class="micro">Related by region or topic. These links do not establish historical influence.</p><ul class="source-list">{related.map(item=><><li><a href={`/event/${item.id}/`}>{item.title}</a> <small>{item.date} · {item.region}</small></li>{' '}</>)}</ul><a href="/">Compare two date bands →</a></aside></div>
 <References sources={event.sources}/>
 <script>import '../../lib/library';</script>
</Shell>
