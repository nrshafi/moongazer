---
import learning from '../data/learning.json';
import Shell from '../layouts/Shell.astro';import HowItWorks from '../components/HowItWorks.astro';import '../styles/app.css';import {lessons,audio} from '../data/content.json';
---
<Shell title="Understand Your Salah"><section class="intro"><span class="motif" aria-hidden="true"></span><div class="intro-top"><span class="pill"><span class="dot"></span>{lessons.length} lessons</span></div> <h1>{learning.heading}</h1> <p>{lessons.length} lessons on the words of prayer.</p></section><section class="panel bottom-gap"><div class="panel-body filters"><label class="field">Search<input id="filter" type="search" placeholder="Bowing, Al-Fatiha, praise…"/></label> <label class="field">Part of prayer<select id="category"><option value="">All lessons</option>{[...new Set(lessons.map(l=>l.area))].map(a=><option>{a}</option>)}</select></label> <label><input type="checkbox" id="saved-only"/> Saved only</label> <button class="button secondary" id="export">Copy my list</button><span id="count" class="micro" aria-live="polite"></span></div></section><div class="card-grid">{lessons.map(l=><><article class="panel activity-card" data-item-id={l.id} data-category={l.area}><span class="eyebrow">{l.area} · {l.audio?'Full-surah audio':'Text lesson'}</span> <h2><a data-reading-link={l.id} href={`/lesson/${l.id}/`}>{l.title}</a></h2> <p class="arabic" lang="ar" dir="rtl">{l.arabic.length>80?l.arabic.slice(0,80)+'…':l.arabic}</p> <div class="actions"><a class="button" href={`/lesson/${l.id}/`}>Open lesson ↗</a> <button class="button secondary" data-save={l.id} aria-pressed="false">Save</button></div></article>{' '}</>)}</div> <div class="empty" id="empty" hidden><h2>No lessons match</h2> <p>Try another word or choose All lessons.</p></div> <div class="workspace top-gap"><section class="panel panel-body"><span class="eyebrow">Listen locally</span> <h2>Al-Fatiha, in full</h2><audio controls preload="none" src={audio.file} aria-label="Al-Fatiha recited by Adeel Shaikh" style="width:100%">Your browser does not support this audio. <a href={audio.file}>Download the recording</a>.</audio><p class="micro">Adeel Shaikh · CC BY-SA 4.0. Full-surah recording, about 50 seconds. <a href={audio.source} target="_blank" rel="noopener noreferrer">Recording and attribution ↗</a></p></section> <aside class="sidebar"><HowItWorks><p>Explore the meaning lessons, from the opening takbir to the closing greeting. Read the Arabic, reveal its meaning, and check a detail.</p><p><strong>About these lessons.</strong> Selected narrated wordings, not a full legal prayer manual. Roman guides are approximate. Local audio is included for Al-Fatiha; the other lessons are text-based.</p><p><a href="/sources/">Sources and wordings ↗</a></p></HowItWorks></aside></div><script>import '../lib/library';</script></Shell>
