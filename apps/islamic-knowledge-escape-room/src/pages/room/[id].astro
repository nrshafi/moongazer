---
import Shell from '../../layouts/Shell.astro';
import {rooms} from '../../data/content.json';
export function getStaticPaths(){return rooms.map(room=>({params:{id:room.id},props:{room}}));}
const {room}=Astro.props;
---
<Shell title={room.name}><a href="/" class="back-link">← All rooms</a><section class="intro"><span class="eyebrow">Read together. Think it through.</span> <h1>{room.name}</h1> <p>Four locks, three source passages. The sources stay available throughout.</p></section><div id="room" data-room={room.id}><div class="actions bottom-gap"><label><input id="resume" type="checkbox"/> Remember this room for 30 days</label> <label><input id="timer-toggle" type="checkbox"/> Show optional timer</label> <span id="timer" class="pill" hidden>0:00</span> <button id="restart" class="text-button">Restart room</button></div> <div class="workspace"><section class="panel"><div class="panel-head"><h2 id="lock-title">Open the first lock</h2> <span id="lock-progress" class="pill">Lock 1 of 4</span></div> <div class="panel-body" id="puzzle" aria-live="polite"><p>Preparing the room…</p></div></section><aside class="sidebar"><div class="notice"><h2>How to play</h2> <p>Connect a theme, match translations to references, arrange cards in Quran chapter order, then recognize excerpts.</p><p>Use the sources below at any time. A wrong answer keeps the lock open for another attempt.</p> <a href="#source-shelf">Go to the sources ↓</a></div></aside></div></div><section id="source-shelf" class="top-gap"><h2>Sources</h2>{room.passages.map(p=><details class="panel bottom-gap"><summary style="padding:18px;cursor:pointer">Quran {p.ref} · Arabic and Pickthall</summary><div class="panel-body"><p class="arabic" lang="ar" dir="rtl">{p.arabic}</p><blockquote class="source-quote">{p.translation}</blockquote><a href={p.translationUrl} target="_blank" rel="noopener noreferrer">Read the surrounding passage ↗</a></div></details>)}<p class="micro">Theme explanations are editorial learning aids. <a href={room.commentaryUrl} target="_blank" rel="noopener noreferrer">Read the anchor’s Al-Tafsir al-Muyassar commentary ↗</a></p></section><noscript><p class="noscript">The puzzles require JavaScript. All source passages remain readable here.</p></noscript><script>import '../../lib/app';</script></Shell>
