---
import guide from '../data/learning.json';
---
<section class="learning-guide" aria-labelledby="learning-guide-title">
  <div class="guide-heading"><p class="eyebrow">A useful starting point</p><h2 id="learning-guide-title">How this app works</h2><p>{guide.summary}</p></div>{' '}
  <div class="guide-columns">
    <section><h3>Try it in three steps</h3><ol>{guide.steps.map(step=><><li>{step}</li>{' '}</>)}</ol><a class="guide-subject" href={guide.collection.url}>Explore {guide.collection.name} tools <span aria-hidden="true">→</span></a></section>{' '}
    <section aria-label="Questions about this app">{guide.questions.map(item=><><details class="guide-answer"><summary>{item.question}</summary><p>{item.answer}</p></details>{' '}</>)}</section>
  </div>
  <nav class="guide-related" aria-label="Related learning apps"><h3>Continue learning</h3> <div>{guide.related.map(app=><><a href={app.url}><strong>{app.name}</strong> <span>{app.description}</span> <span class="guide-open">Open {app.kind.toLowerCase()} <span aria-hidden="true">→</span></span></a>{' '}</>)}</div></nav>
  <p class="guide-note">Inspect this app's <a href="/sources/">sources and methodology</a>, or read <a href="https://moongazer.tech/about/">about Moongazer and source corrections</a>.</p>
</section>
<style>
  .learning-guide{margin-top:64px;padding-top:36px;border-top:1px solid var(--line)}
  .guide-heading{max-width:820px}.guide-heading h2{font-family:Newsreader,Georgia,serif;font-size:2rem}.guide-heading>p:last-child{color:var(--muted);line-height:1.8}
  .guide-columns{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:26px}.guide-columns h3,.guide-related h3{font-size:1rem;line-height:1.5;letter-spacing:0}.guide-columns ol{padding-left:24px;color:var(--muted);line-height:1.8}.guide-columns li{padding-left:4px;margin-bottom:12px}.guide-subject{color:var(--accent-ink);text-decoration:underline;text-underline-offset:4px}
  .guide-answer{border-bottom:1px solid var(--line)}.guide-answer:first-of-type{border-top:1px solid var(--line)}.guide-answer>summary{cursor:pointer;min-height:44px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 2px;font-weight:600;font-size:1rem;line-height:1.5;list-style:none}.guide-answer>summary::-webkit-details-marker{display:none}.guide-answer>summary::after{content:'+';flex-shrink:0;font-size:1.2rem;line-height:1;color:var(--muted)}.guide-answer[open]>summary::after{content:'\2212'}.guide-answer p{color:var(--muted);line-height:1.8;font-size:.9rem;margin:0 0 16px}
  .guide-related{display:block;margin-top:26px}.guide-related>div{display:grid;grid-template-columns:1fr 1fr;gap:16px}.guide-related a{display:flex;flex-direction:column;align-items:flex-start;gap:10px;padding:22px;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);min-width:0}.guide-related strong{font-weight:600;overflow-wrap:anywhere}.guide-related span{font-size:.84rem;color:var(--muted);line-height:1.7}.guide-related .guide-open{color:var(--accent-ink);margin-top:auto;padding-top:6px}.guide-related a:hover{border-color:var(--accent)}
  .guide-note{font-size:.82rem;color:var(--muted);margin:24px 0 0;line-height:1.8}.guide-note a{text-decoration:underline;text-underline-offset:3px}
  @media(max-width:700px){.learning-guide{margin-top:40px;padding-top:28px}.guide-columns,.guide-related>div{grid-template-columns:1fr;gap:20px}.guide-heading h2{font-size:1.7rem}}
</style>
