---
import Shell from '../../layouts/Shell.astro';
import Honorific from '../../components/Honorific.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import learning from '../../data/learning.json';
import '../../styles/app.css';
import {people} from '../../data/content.json';
export function getStaticPaths(){return people.map(person=>({params:{id:person.id},props:{person}}));}
const {person}=Astro.props;const nextApp=learning.related[0];const next=people[(people.findIndex(p=>p.id===person.id)+1)%people.length];
---
<Shell title={person.name}><a href="/" class="back-link">← All prophets</a><section class="intro"><span class="eyebrow">{person.category} · selected Quran readings</span> <h1>{person.name}</h1> <p>{person.focus}. Selected Quran readings about {person.name}{person.id==="muhammad"?null:<Honorific kind="other" />}.</p> <div class="actions hero-actions"><button class="button secondary" data-save={person.id} aria-pressed="false">Save</button> <button class="button secondary" data-print>Print readings</button></div></section><div class="workspace"><section>{person.readings.map((r,i)=><><article class="panel bottom-gap" id={`reading-${i+1}`}><div class="panel-head"><h2>Reading {i+1} · Quran {r.ref}</h2> <a href={r.translationUrl} target="_blank" rel="noopener noreferrer">Read context ↗</a></div> <div class="panel-body"><blockquote class="source-quote">{r.translation}</blockquote><p class="micro">Marmaduke Pickthall · historical English wording</p></div></article>{' '}</>)}</section> <aside class="sidebar"><HowItWorks>{' '}<p>These are selected passages with a named translation, not a full biography.</p>{person.brief&&<p>The Quran mentions {person.name} briefly in these passages. This page makes no claim about dates, locations, or a fuller biography beyond the cited text.</p>}<p>Open "Read context" on a passage to see its surrounding verses.</p></HowItWorks>{' '}<section class="panel panel-body"><span class="eyebrow">Pause and notice</span> <h2>Reading check</h2> <p>{person.question}</p><form id="quiz" data-answer={person.answer} data-reference={person.answerRef} data-item-id={person.id} data-name={person.name} data-next-name={nextApp.name} data-next-url={nextApp.url}><fieldset><legend class="sr-only">Choose an answer</legend>{person.options.map((option,i)=><><label style="display:block;margin:14px 0"><input type="radio" name="answer" value={i} required/> {option}</label>{' '}</>)}</fieldset><button class="button">Check answer</button><p id="feedback" role="status"></p></form><div id="session-end" aria-live="polite"></div><p class="micro">An editorial comprehension exercise. The question checks a stated detail, not a complete interpretation.</p></section> <div class="notice"><h2>Keep reading</h2> <a href={`/prophet/${next.id}/`}>Next prophet: {next.name} ↗</a><p>Library sequence only; it does not indicate chronology.</p></div></aside></div><script is:inline>document.body.setAttribute('data-projector','');</script><script>import '../../lib/library';import '../../lib/quiz';</script></Shell>
