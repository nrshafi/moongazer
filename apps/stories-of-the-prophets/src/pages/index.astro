---
import learning from '../data/learning.json';
import Shell from '../layouts/Shell.astro';
import HowItWorks from '../components/HowItWorks.astro';
import '../styles/app.css';
import {people} from '../data/content.json';
const sorted=[...people].sort((a,b)=>a.name.localeCompare(b.name));
---
<Shell title="Stories of the Prophets"><section class="intro"><span class="motif" aria-hidden="true"></span><h1>{learning.heading}</h1> <p>25 prophets · 50 selected readings from the Quran.</p></section><div class="workspace"><div class="library-main"><section class="panel bottom-gap"><div class="panel-body filters"><label class="field">Find a prophet or reading<input id="filter" type="search" placeholder="Musa, gratitude, patience…"/></label> <label class="field">Reading area<select id="category"><option value="">All areas</option>{[...new Set(people.map(p=>p.category))].sort().map(g=><option>{g}</option>)}</select></label> <label><input type="checkbox" id="saved-only"/> Saved only</label> <button class="button secondary" id="export">Copy my list</button><span class="micro" id="count" aria-live="polite"></span></div></section><p class="micro order-note">Listed A–Z. No historical order is implied.</p> <div class="card-grid">{sorted.map((p)=><><article class="panel activity-card" data-item-id={p.id} data-category={p.category}><span class="eyebrow">{p.category}</span> <h2><a href={`/prophet/${p.id}/`} data-reading-link={p.id}>{p.name}</a></h2> <p>{p.focus}</p> <span class="micro">{p.readings.map(r=>r.ref).join(' · ')}</span> <div class="actions"><a class="button" href={`/prophet/${p.id}/`}>Open readings ↗</a> <button class="button secondary" data-save={p.id} aria-pressed="false">Save</button></div></article>{' '}</>)}</div> <div class="empty" id="empty" hidden><h2>Nothing matches</h2> <p>Try another name or reading focus, or turn off Saved only.</p></div></div><aside class="sidebar"><HowItWorks><p>This is a selected reading library, not a complete biography collection. Prophets are listed alphabetically; no historical order is implied. Brief mentions are presented without adding an unsourced life story.</p><ol>{learning.steps.map(t=><li>{t}</li>)}</ol></HowItWorks></aside></div><script is:inline>document.body.setAttribute('data-projector','');</script><script>import '../lib/library';</script></Shell>
