---
import Shell from '../layouts/Shell.astro';
import HowItWorks from './HowItWorks.astro';
import '../styles/app.css';
interface Source {label:string;url:string;kind?:string;note?:string}
interface Item {id:string;title:string;topic:string;ref:string;scene:string;passage:{ref:string;arabic:string;translation:string;url:string};commentaryUrl:string;secondCommentaryUrl?:string;sources?:Source[]}
interface Props {item:Item;base:'scenario'|'business'}
const {item,base}=Astro.props;
const business=base==='business';
const sources=item.sources??[];
---
<Shell title={item.title}>
  <a class="back-link" href={business?'/business/':'/'}>← {business?'All business scenarios':'All scenarios'}</a>
  <section class="intro"><div class="intro-text"><h1 class="editorial">{item.title}</h1> <p>Choose a response, then see what could follow.</p> <span class="pill count-chip">{business?'Business · ':''}{item.topic}</span></div><img class="motif" src="/motif.svg" alt="" width="220" height="140" aria-hidden="true"/></section>
  <div class="workspace" id="scenario" data-scenario={item.id} data-base={base}><section class="panel"><div class="panel-head"><span class="label" id="step-label">The first decision</span><div class="step-dots" id="scenario-dots" aria-label="Two decisions"><span class="done"></span> <span></span></div></div> <div class="panel-body" id="scenario-stage" aria-live="polite"><p class="scene-text">{item.scene}</p><noscript><div class="noscript">Enable JavaScript to explore the branching choices. The cited Quran passage remains readable below.</div></noscript></div></section> <aside class="sidebar sticky"><HowItWorks><p><strong>No timer. No character score.</strong> There is time to think. Notice the people affected, what you know, and what you might need to ask before acting.</p><p>This scenario refers to <a class="citation" href={item.passage.url} target="_blank" rel="noopener noreferrer">Quran {item.ref} ↗</a>. The scene and possible consequences are editorial applications, rather than a report about the verse's original setting.</p></HowItWorks><section class="panel panel-body"><label class="check"><input type="checkbox" id="remember"/>Remember this scenario for up to 30 days</label><div class="divider"></div> <button class="text-button" id="scenario-share">Copy scenario link</button><p class="micro top-gap"><button class="text-button" id="scenario-restart">Try a different response</button></p>{business&&<p class="micro top-gap"><button class="text-button" data-save={item.id} aria-pressed="false">Save</button></p>}</section></aside></div>
  <details class="panel panel-body top-gap"><summary>Read the cited Quran passage · {item.ref}</summary><p class="arabic" lang="ar" dir="rtl">{item.passage.arabic}</p><blockquote class="source-quote"><p>{item.passage.translation}</p><cite>Marmaduke Pickthall · Quran {item.ref}</cite></blockquote><a class="citation" href={item.commentaryUrl} target="_blank" rel="noopener noreferrer">Read Al-Tafsir al-Muyassar for this ayah ↗</a><p class="micro top-gap">Grounded with quran.ai: fetch_quran({item.ref}, ar-uthmani-hafs), fetch_translation({item.ref}, en-pickthall), fetch_tafsir({item.ref}, ar-muyassar).</p></details>
  {business&&<section class="panel panel-body top-gap"><h2>Follow the evidence</h2><ul class="source-list">{sources.map(s=><><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a><small>{s.note}</small></li>{' '}</>)}<li><a href={item.commentaryUrl} target="_blank" rel="noopener noreferrer">Al-Tafsir al-Muyassar ↗</a><small>Fetched Arabic commentary. English notes here are original concise paraphrases.</small></li>{' '}{item.secondCommentaryUrl&&<li><a href={item.secondCommentaryUrl} target="_blank" rel="noopener noreferrer">Al-Qurtubi · further Arabic legal discussion ↗</a><small>Read the full discussion. A source link does not make every scenario prompt a scholarly statement.</small></li>}</ul><p class="micro">Fictional scenario. It does not certify a real transaction as halal, replace a qualified adviser or give legal or financial advice.</p></section>}
</Shell>
<script>import '../lib/scenario';import '../lib/business-save';</script>
<style>summary{cursor:pointer;font-size:.85rem;font-weight:600}</style>
