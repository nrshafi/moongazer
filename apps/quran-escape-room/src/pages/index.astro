---
import learning from '../data/learning.json';
import Shell from '../layouts/Shell.astro';
import HowItWorks from '../components/HowItWorks.astro';
import '../styles/app.css';
import {rooms} from '../data/content.json';
---
<Shell title="Quran Escape Room"><script is:inline>document.querySelector('main')?.setAttribute('data-projector','')</script><section class="intro"><div class="intro-text"><h1>{learning.heading}</h1> <p>Eight rooms. Four locks each.</p> <span class="pill neutral count-chip">{rooms.length} rooms</span></div><img class="motif" src="/motif.svg" alt="" width="220" height="140" aria-hidden="true"/></section><div class="workspace"><div class="library card-grid">{rooms.map((r,i)=><article class="panel activity-card"><span class="eyebrow">Room {i+1} · four locks</span> <h2>{r.name}</h2> <p>{r.description}</p><div class="lock-preview" aria-label="Four locks, all locked">◇ — ◇ — ◇ — ◇ <span class="lock-preview-text">Locked</span></div> <a href={`/room/${r.id}/`} class="button">Enter room <span aria-hidden="true">→</span></a></article>)}</div><aside class="sidebar"><HowItWorks><p>Read, connect, arrange, and recognize. Choose a room for a solo challenge or work together on one device. Press Projector for large text on a shared screen.</p><p>Every room includes its sources. Open them whenever you need. Hints and solutions are available; this is a reading activity, not a measure of faith or religious merit.</p></HowItWorks></aside></div></Shell>
