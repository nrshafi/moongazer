---
interface Props { passage?: {ref:string; arabic?:string; translation:string; translationUrl:string}; }
const {passage:p}=Astro.props;
---
{p&&<section class="panel bottom-gap"><div class="panel-head"><h2>The source reading</h2><a href={p.translationUrl} target="_blank" rel="noopener noreferrer">Quran {p.ref} ↗</a></div> <div class="panel-body"><blockquote class="source-quote">{p.translation}</blockquote><p class="micro">Marmaduke Pickthall · complete selected ayahs</p></div></section>}
