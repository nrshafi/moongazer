---
import {places,landPaths} from '../data/content.json';
const {focus=''}=Astro.props;
const markers=places.filter(p=>p.point);
---
<figure class="map-figure"><svg viewBox="0 0 840 560" role="img" aria-labelledby="map-title map-description"><title id="map-title">Selected modern geographical contexts</title><desc id="map-description">Five linked city or heritage markers on a regional land map. Uncertain locations are listed below without invented pins. The numbered legend provides accessible links.</desc><defs><clipPath id="map-clip"><rect width="840" height="560" rx="18"/></clipPath></defs><g clip-path="url(#map-clip)"><rect width="840" height="560" fill="var(--surface-2)"/>{[20,25,30,35,40].map(lat=><g><line x1="0" x2="840" y1={(42-lat)*17.5} y2={(42-lat)*17.5} stroke="var(--line)"/><text x="8" y={(42-lat)*17.5-5} fill="var(--muted)" font-size="12">{lat}°N</text></g>)}<g fill="var(--tint)">{landPaths.map(d=><path d={d}/>)}</g><text x="190" y="215" fill="var(--muted)" font-size="17">Egypt</text><text x="445" y="350" fill="var(--muted)" font-size="19">Arabia</text><text x="270" y="415" fill="var(--muted)" font-size="15" transform="rotate(50 270 415)">Red Sea</text>{markers.map((p,i)=><><a href={`/place/${p.id}/`} aria-label={`${p.name}: ${p.kind}`}><title>{p.name} · {p.kind}</title><circle cx={(p.point![0]-20)*21} cy={(42-p.point![1])*17.5} r={focus===p.id?20:15} fill={focus===p.id?'var(--ink)':'var(--accent)'} stroke="var(--surface)" stroke-width="3"/><text x={(p.point![0]-20)*21} y={(42-p.point![1])*17.5+5} text-anchor="middle" fill="var(--bg)" font-size="15" font-weight="700">{i+1}</text></a>{' '}</>)}</g></svg><figcaption><span class="micro">Regional orientation only. Modern city and heritage-site contexts, not reconstructed event sites. Land geometry: Natural Earth, public domain.</span><ol class="map-legend">{markers.map(p=><><li><a href={`/place/${p.id}/`}>{p.name}</a> <small>{p.kind}</small></li>{' '}</>)}</ol></figcaption></figure>
<style>.map-figure{margin:0}.map-figure svg{width:100%;height:auto}.map-legend{display:flex;flex-wrap:wrap;gap:12px 28px;padding-left:25px;font-size:.8rem}.map-legend small{display:block;color:var(--muted);font-size:.65rem}.map-figure a:focus-visible circle{stroke:var(--ink);stroke-width:6}</style>
