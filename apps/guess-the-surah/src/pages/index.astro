---
import learning from '../data/learning.json';
import Shell from '../layouts/Shell.astro';
import data from '../data/content.json';
---
<Shell title="Guess the Surah">
  <section class="intro"><div class="intro-top"><span class="eyebrow">A little curiosity goes a long way</span><span class="pill"><span class="dot"></span>51 short surahs</span></div><h1>{learning.heading}</h1><p>Start with a passage, uncover a little more, and find the surah. Every answer leads back to its source.</p></section>
  <noscript><div class="noscript">The guessing game needs JavaScript for scoring and clues. You can still explore the complete surah list and source references on the <a href="/sources/">sources page</a>.</div></noscript>
  <div class="workspace">
    <section class="panel" aria-label="Surah guessing game">
      <div class="panel-head"><div><span class="label" id="round-label">Your next discovery</span><p id="round-subtitle">Take your time. Clues are here to help.</p></div><span class="pill neutral" id="score-label">0 points</span></div>
      <div class="progress-track" role="progressbar" aria-label="Round progress" aria-valuemin="0" aria-valuemax="10" aria-valuenow="0" id="round-progress"><span id="round-bar" style="width:0%"></span></div>
      <div class="panel-body" id="game-stage" aria-live="polite"><p class="muted">Preparing your clues…</p></div>
    </section>
    <aside class="sidebar sticky">
      <section class="panel panel-body"><h2>Make it your round</h2><form id="setup-form"><label class="field bottom-gap">Surah collection<select id="pool"><option value="short">Short surahs · 30 ayahs or fewer</option><option value="all">All 114 surahs</option><option value="makkah">Makkan classification</option><option value="madinah">Madinan classification</option></select></label><label class="field bottom-gap">Round length<select id="length"><option value="5">5 surahs</option><option value="10" selected>10 surahs</option><option value="20">20 surahs</option></select></label><button class="button wide" type="submit">Start a new round</button></form><div class="divider"></div><label class="check"><input type="checkbox" id="remember"/>Remember this round for up to 30 days</label></section>
      <section class="panel panel-body"><h2>A clue at a time</h2><ol><li>Read the clue ayah in Pickthall's translation.</li><li>Reveal the Arabic, ayah count, and chapter position when you need them.</li><li>Choose one of four surahs. Earlier answers earn more points.</li></ol><div class="divider"></div><button class="text-button" id="share-challenge" type="button">Copy this challenge link</button><p class="micro top-gap">An informal challenge, with identical clues for anyone using the link.</p></section>
    </aside>
  </div>
  <details class="top-gap panel panel-body"><summary>Surah list (contains answers)</summary><div class="surah-directory">{data.chapters.map(s=><a href={`https://quran.com/${s.number}`} target="_blank" rel="noopener noreferrer"><span class="surah-number">{s.number}</span><span>{s.name_simple}<small>{s.verses_count} ayahs</small></span><span lang="ar" dir="rtl">{s.name_arabic}</span></a>)}</div></details>
</Shell>
<script>import '../lib/game';</script>
<style>
  summary{cursor:pointer;font-size:.85rem;font-weight:600}.surah-directory{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:22px}.surah-directory a{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid var(--line);border-radius:10px;text-decoration:none;font-size:.78rem;color:var(--ink)}.surah-directory small{display:block;color:var(--muted);font-size:.66rem;margin-top:3px}.surah-directory [lang=ar]{margin-left:auto;font-family:Amiri,serif;font-size:1.05rem}.surah-number{color:var(--muted);font-size:.68rem;min-width:20px}@media(max-width:860px){.surah-directory{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:580px){.surah-directory{grid-template-columns:1fr}}
</style>
