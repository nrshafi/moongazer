---
import Shell from '../../layouts/Shell.astro';import Map from '../../components/Map.astro';import {places} from '../../data/content.json';export function getStaticPaths(){return places.map(place=>({params:{id:place.id},props:{place}}));}const {place}=Astro.props;const p=place.passage;
---
<Shell title={place.name}><a class="back-link" href="/">← All places</a><section class="intro"><span class="eyebrow">{place.kind}</span> <h1>{place.name}</h1> <p>{place.summary}</p></section><div class="workspace"><section><article class="panel bottom-gap"><div class="panel-head"><h2>Quran {p.ref}</h2> <a href={p.translationUrl} target="_blank" rel="noopener noreferrer">Read context ↗</a></div> <div class="panel-body"><p class="arabic" lang="ar" dir="rtl">{p.arabic}</p><blockquote class="source-quote">{p.translation}</blockquote><p class="micro">Marmaduke Pickthall</p><a href={place.commentaryUrl} target="_blank" rel="noopener noreferrer">Al-Tafsir al-Muyassar ↗</a><p class="micro">Entry summary is an original concise paraphrase of the cited reading/commentary.</p></div></article>{place.point&&<section class="panel panel-body"><Map focus={place.id}/><a href={place.geoUrl} target="_blank" rel="noopener noreferrer">Coordinate source: {place.geoLabel} ↗</a><p class="micro">Marker: {place.point[1].toFixed(4)}°N, {place.point[0].toFixed(4)}°E. Display precision is not historical site precision.</p></section>}</section> <aside class="sidebar"><div class="notice"><h2>What the map can establish</h2> <p>{place.note}</p>{!place.point&&<p>No coordinate has been assigned to this entry.</p>}</div> <div class="panel panel-body"><button class="button secondary wide" data-save={place.id} aria-pressed="false">Save reading</button><p class="micro top-gap">Bookmarks are optional and stay in this browser for up to 30 days.</p><button class="text-button" data-print>Print this entry</button></div></aside></div><script>import '../../lib/library';</script></Shell>
