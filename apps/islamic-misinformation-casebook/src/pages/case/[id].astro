---
import Shell from '../../layouts/Shell.astro';
import Passage from '../../components/Passage.astro';
import References from '../../components/References.astro';
import {verdicts} from '../../lib/assessment';
import {cases} from '../../data/content.json';
export function getStaticPaths(){return cases.map(item=>({params:{id:item.id},props:{item}}));}
const {item}=Astro.props;
const reading='passage' in item?item.passage:undefined;
const share=`${item.title}\nConstructed source-reading exercise\nConclusion: ${item.verdict}\n${item.correction}\nLimit: ${item.limit}\n${reading?reading.url+'\n':''}${item.sources.map(source=>source.label+': '+source.url).join('\n')}${'commentaryUrl' in item?'\n'+item.commentaryUrl:''}\n`;
---
<Shell title={item.title}>
 <a class="back-link" href="/">← All evidence cases</a><section class="intro"><span class="eyebrow">{item.topic} · source-reading exercise</span> <h1 class="editorial">{item.title}</h1> <p>Inspect the exact claim. Read what supports a conclusion and what remains outside the evidence.</p></section>
 <section class="panel panel-body bottom-gap"><span class="eyebrow">Claim to examine</span> <h2>{item.claim}</h2> <p class="micro">A constructed exercise tied to the sources below. This does not assert that the claim is a measured viral trend or attribute it to a person.</p></section>
 <Passage passage={reading}/>
 <div class="dossier"><section class="panel panel-body"><h2>Open the evidence</h2> <p id="evidence-count" class="micro" aria-live="polite">0 evidence cards open</p>{item.evidence.map((entry,index)=><details class="evidence-card" data-evidence><summary>{index+1}. {entry.title}</summary><div><p>{entry.text}</p></div></details>)}<References sources={item.sources} commentaryUrl={'commentaryUrl' in item?item.commentaryUrl:undefined}/></section> <aside class="panel panel-body"><h2>Choose a careful conclusion</h2><form id="conclusion-form" data-verdict={item.verdict}><fieldset><legend>What does this cited material support?</legend>{verdicts.map(verdict=><><label class="quiz-option"><input type="radio" name="answer" value={verdict} required/>{verdict}</label>{' '}</>)}</fieldset><button class="button top-gap">Compare my conclusion</button><p id="verdict-feedback" class="micro top-gap" role="status"></p></form><section class="reading-note" id="conclusion" hidden><h3>{item.verdict}</h3><p>{item.correction}</p><h3>Keep this limit</h3><p>{item.limit}</p><div class="source-boundary">Reading habit: {item.skill}</div><button class="button secondary top-gap" id="copy-correction">Copy correction with references</button></section><noscript><h3>The bounded conclusion</h3><p>{item.correction}</p><p>{item.limit}</p></noscript><button class="text-button top-gap" id="retry-case">Try the conclusion again</button></aside></div>{' '}
 <div class="reading-actions"><button class="button secondary" data-save={item.id} aria-pressed="false">Save for later</button> <button class="button secondary" data-print>Print evidence worksheet</button></div>
 <script id="share-data" type="application/json" set:html={JSON.stringify(share).replace(/</g,'\\u003c')}/>
 <script>import '../../lib/library';import '../../lib/investigate';</script>
</Shell>
