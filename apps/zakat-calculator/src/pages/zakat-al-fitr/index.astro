---
import Shell from '../../layouts/Shell.astro';
import MethodEntry from '../../components/MethodEntry.astro';
import { entryById, FITR_SENTENCE, LIMIT_SENTENCE } from '../../lib/zakat';
import '../../styles/zakat.css';
const facts = entryById('fitr-facts')!;
const food = entryById('fitr-food-vs-cash')!;
// Drop the record's own instructions to the app; the sentence itself is shown below.
const skip = /^(No amounts are recorded|The calculator does not compute)/;
---
<Shell title="Zakat al-fitr" active="fitr">
  <article class="prose method">
    <header>
      <span class="eyebrow">At the end of Ramadan</span>
      <h1>Zakat al-fitr: who pays and when</h1>
      <p>This page explains the facts and the documented difference about food or cash. It does not give an amount and the calculator does not work it out.</p>
      <p class="fitr-ask">{FITR_SENTENCE}</p>
      <p class="notice warning">{LIMIT_SENTENCE}</p>
    </header>{' '}
    <MethodEntry entry={facts} skipNotes={skip} />{' '}
    <MethodEntry entry={food} skipNotes={skip} />{' '}
    <p class="fitr-ask">{FITR_SENTENCE}</p>{' '}
    <p class="actions top-gap"><a class="button" href="/">Return to the calculator <span aria-hidden="true">→</span></a> <a class="button secondary" href="/method/">Full method page</a></p>
  </article>
</Shell>
