---
import Shell from '../../layouts/Shell.astro';import {lessons,audio} from '../../data/content.json';export function getStaticPaths(){return lessons.map(lesson=>({params:{id:lesson.id},props:{lesson}}));}const {lesson}=Astro.props;const index=lessons.findIndex(l=>l.id===lesson.id);const next=lessons[(index+1)%lessons.length];
---
<Shell title={lesson.title}><a class="back-link" href="/">← All lessons</a><section class="intro"><span class="eyebrow">{lesson.area} · lesson {index+1} of {lessons.length}</span><h1>{lesson.title}</h1><p>Read the Arabic. Try to recall the meaning, then show it.</p></section><div class="workspace"><section><article class="panel bottom-gap"><div class="panel-head"><h2>{lesson.passage?'Quran · '+lesson.passage.ref:'Narrated recitation'}</h2><button class="button secondary small js-only" id="practice" type="button" aria-expanded="false" aria-controls="meaning">Show meaning</button></div><div class="panel-body"><p class="arabic" lang="ar" dir="rtl">{lesson.arabic}</p>{lesson.transliteration&&<p class="micro">Approximate Roman guide: {lesson.transliteration}</p>}<div id="meaning" class="meaning-panel"><span class="eyebrow">{lesson.passage?'Marmaduke Pickthall':'Our concise English rendering'}</span><blockquote class="source-quote">{lesson.meaning}</blockquote></div>{lesson.note&&<p class="micro">{lesson.note}</p>}{lesson.passage&&<p><a href={lesson.passage.translationUrl} target="_blank" rel="noopener noreferrer">Quran {lesson.passage.ref} · read context ↗</a></p>}{lesson.commentaryUrl&&<p><a href={lesson.commentaryUrl} target="_blank" rel="noopener noreferrer">Al-Tafsir al-Muyassar ↗</a></p>}{lesson.sources.map(s=><p><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></p>)}</div></article>{lesson.audio&&<section class="panel panel-body"><h2>Listen to the whole surah</h2><audio id="recitation" controls preload="metadata" src={audio.file} aria-label="Full Al-Fatiha recording by Adeel Shaikh" style="width:100%"></audio><div class="filters top-gap"><label class="field">Playback speed<select id="speed"><option value="0.75">0.75×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option></select></label><label><input id="loop" type="checkbox"/> Repeat full surah</label></div><p id="audio-error" class="micro" hidden>Audio could not load. Try reloading or download the local recording.</p><p class="micro">This plays Al-Fatiha in full, not an isolated ayah. Adeel Shaikh · <a href={audio.licenseUrl}>CC BY-SA 4.0</a>. <a href={audio.source}>Source recording</a> · <a href={audio.file} download>Download audio</a></p></section>}</section><aside class="sidebar"><section class="panel panel-body"><span class="eyebrow">Check understanding</span><h2>One detail</h2><p>{lesson.question}</p><form id="quiz" data-answer={lesson.answer}><fieldset><legend class="sr-only">Choose an answer</legend>{lesson.options.map((o,i)=><label class="quiz-option"><input type="radio" name="answer" value={i} required/> {o}</label>)}</fieldset><button class="button top-gap">Check answer</button><p id="feedback" role="status"></p></form></section><section class="panel panel-body"><button class="button secondary wide" data-save={lesson.id} aria-pressed="false">Save reading</button><a class="button secondary wide top-gap" href={`/lesson/${next.id}/`}>Next: {next.title} ↗</a><button class="text-button top-gap" data-print>Print this lesson</button></section></aside></div><script>import '../../lib/library';import '../../lib/lesson';</script></Shell>
<style>
  /* The head script always sets data-theme, so it marks pages where JavaScript runs.
     Without JavaScript the meaning stays visible and the toggle stays hidden. */
  .js-only{display:none}
  :root[data-theme] .js-only{display:inline-flex}
  :root[data-theme] .meaning-panel:not(.revealed){display:none}
  @media print{.meaning-panel{display:block!important}.js-only{display:none!important}}
</style>
