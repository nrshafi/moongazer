---
import Shell from '../../layouts/Shell.astro';
import data from '../../data/content.json';
export function getStaticPaths(){return data.events.map((item,index)=>({params:{slug:item.id},props:{item,index}}));}
interface Props {item:typeof data.events[number];index:number;}
const {item,index}=Astro.props;const previous=data.events[index-1];const next=data.events[index+1];
---
<Shell title={item.title}>
  <a class="back-link" href={`/?event=${item.id}`}>← Explore the chronology</a>
  <article class="prose"><span class="eyebrow">{item.era} · {item.number} of {data.events.length}</span><h1 class="editorial">{item.title}</h1><div class="actions bottom-gap"><span class="pill">{item.date}</span><span class="pill neutral">{item.place}</span><span class="pill neutral">{item.topic}</span></div><p class="event-lead">{item.summary}</p><h2>About the date</h2><p>{item.uncertainty}</p><h2>Source report</h2><ul class="source-list">{item.sources.map(source=><li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a><small>A concise original paraphrase is shown above. Open the report to read it in full.</small></li>)}</ul>{item.passages.map(p=><section class="panel panel-body top-gap"><span class="eyebrow">Related Quran passage · {p.ref}</span><p class="arabic" lang="ar" dir="rtl">{p.arabic}</p><blockquote class="source-quote"><p>{p.translation}</p><cite>Marmaduke Pickthall</cite></blockquote><a class="citation" href={p.translationUrl} target="_blank" rel="noopener noreferrer">Read Quran {p.ref} ↗</a></section>)}<div class="notice warning top-gap">The timeline uses approximate chronological bands. Report evidence and date precision are separate questions. This collection is a selected chronology of the prophetic mission.</div><div class="actions top-gap no-print">{previous&&<a class="button secondary" href={`/event/${previous.id}/`}>← Previous event</a>}{next&&<a class="button" href={`/event/${next.id}/`}>Next event →</a>}<button class="button ghost" data-print>Print event</button></div></article>
</Shell>
<style>.event-lead{font-family:Newsreader,Georgia,serif;font-size:1.45rem!important;color:var(--ink)!important;line-height:1.7!important}.prose{max-width:780px}.prose .arabic{font-size:1.8rem}</style>
