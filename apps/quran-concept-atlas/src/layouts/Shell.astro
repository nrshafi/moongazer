---
import LearningGuide from '../components/LearningGuide.astro';
import '../styles/global.css';
import '../styles/refinement.css';
import config from '../data/config.json';
import { getPageMeta, structuredData, encodeJsonLd, productionOrigin } from '../lib/seo';
interface Props { title: string; description?: string; active?: string; }
const { title, description = '', active = 'activity' } = Astro.props;
if (!Astro.site || Astro.site.href !== productionOrigin) throw new Error('Configure the production Astro site URL');
const meta = getPageMeta(Astro.url.pathname);
const pageTitle = meta.title || title;
const pageDescription = description || meta.description;
const canonical = new URL(meta.path, Astro.site).href;
const socialImage = new URL('/social-card.png', Astro.site).href;
const schema = structuredData(meta, Astro.site);
const schemaJson = schema ? encodeJsonLd(schema) : undefined;
const is404 = meta.path === '/404.html';
const themeColors: Record<string, string> = { teal: '#087f75', blue: '#316caa', violet: '#7255a0' };
const themeColor = themeColors[config.accent] ?? themeColors.teal;
---
<!doctype html>
<html lang="en" data-accent={config.accent}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={meta.indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    {!is404 && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={config.name + ' by Moongazer'} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={config.name + ' by Moongazer'} />
    <link rel="preload" href="/fonts/dm-sans.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    {schemaJson && <script type="application/ld+json" is:inline set:html={schemaJson}></script>}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={themeColor} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101a24" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script is:inline define:vars={{ namespace: config.slug }}>
      try { const raw = JSON.parse(localStorage.getItem(namespace + ':theme') || 'null'); const valid = raw && typeof raw.at === 'number' && Number.isFinite(raw.at) && raw.at <= Date.now() + 60000 && Date.now() - raw.at < 2592000000 && ['light','dark'].includes(raw.value); document.documentElement.dataset.theme = valid ? raw.value : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; } catch { document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
    </script>
  </head>
  <body data-app={config.slug}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label={`${config.name} home`}>
          <span class="brand-mark" aria-hidden="true"><img src="/favicon.svg" alt="" width="42" height="42" /></span>{' '}
          <span>{config.name} <small>Islamic learning, explored.</small></span>
        </a>{' '}
        <nav aria-label="Main navigation">
          <a href="/" aria-current={active === 'activity' ? 'page' : undefined}>Explore</a>{' '}
          <a href="/sources/" aria-current={active === 'sources' ? 'page' : undefined}>Sources</a>{' '}
          <button class="icon-button" id="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 14A8.5 8.5 0 0 1 10 3.5 8.5 8.5 0 1 0 20.5 14Z"/></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      {!is404 && <nav class="seo-breadcrumb" aria-label="Breadcrumb"><ol>
        <li><a href="https://moongazer.tech/">Moongazer</a></li>{' '}
        <li>{meta.path === '/' ? <span aria-current="page">{config.name}</span> : <a href="/">{config.name}</a>}</li>
        {meta.path !== '/' && <li><span aria-current="page">{meta.name}</span></li>}
      </ol></nav>}
      <slot />
      {meta.path === '/' && <LearningGuide />}
    </main>
    <footer class="site-footer">
      <div><a class="footer-name" href="/">{config.name}</a><p>Explore at your own pace. Your activity stays in this browser.</p></div>{' '}
      <div class="footer-links"><a href="https://moongazer.tech/#library">All Moongazer apps</a> <a href="https://moongazer.tech/about/">About Moongazer</a> <a href="/sources/">Sources & methodology</a> <a href="/privacy/">Privacy & storage</a> <button type="button" class="text-button" id="storage-open">Manage saved data</button></div>
    </footer>
    <dialog id="storage-dialog" aria-labelledby="storage-title">
      <form method="dialog"><button class="dialog-close icon-button" aria-label="Close storage settings">×</button></form>
      <span class="eyebrow">On this device</span><h2 id="storage-title">Your saved data</h2>
      <p>Theme preferences and any progress you choose to remember stay in this browser. Saved items are ignored after 30 days. Browser storage has no automatic expiry while the site is closed.</p>
      <p>Clearing saved data also resets the current activity. Other apps and websites are unaffected.</p>
      <button type="button" class="button danger" id="storage-clear">Clear this app's saved data</button>
    </dialog>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script>import '../lib/shell';</script>
  </body>
</html>
