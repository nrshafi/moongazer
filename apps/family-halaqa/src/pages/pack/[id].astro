---
import Shell from '../../layouts/Shell.astro';
import Passage from '../../components/Passage.astro';
import References from '../../components/References.astro';import Feedback from '../../components/Feedback.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import '../../styles/app.css';
import {packs} from '../../data/content.json';
export function getStaticPaths(){return packs.map(pack=>({params:{id:pack.id},props:{pack}}));}
const {pack}=Astro.props;
---
<Shell title={pack.title}>
 <script is:inline>document.querySelector('main')?.setAttribute('data-projector','')</script>
 <a class="back-link" href="/">← All family packs</a><section class="intro"><div class="intro-text"><h1 class="editorial">{pack.title}</h1> <p>A reading, a conversation and a shared activity.</p> <div class="pack-chips"><span class="pill">{pack.topic}</span> <span class="pill neutral">Ages {pack.age}</span> <span class="pill neutral">{pack.minutes} minutes</span></div></div><img class="motif" src="/motif.svg" alt="" width="220" height="140" aria-hidden="true"/></section>
 <div class="reading-actions"><button class="button secondary" data-print>Print this pack</button> <button class="button secondary" data-save={pack.id} aria-pressed="false">Save</button></div>
 <Passage passage={'passage' in pack?pack.passage:undefined}/>
 <div class="workspace"><div class="worksheet"><section class="panel panel-body"><h2><span class="prompt-number">1</span> Read and notice</h2> <p>{pack.teaching}</p><form id="reading-question"><fieldset><legend>{pack.question}</legend>{pack.options.map((option,index)=><><label class="quiz-option"><input type="radio" name="answer" value={index} required/>{option}</label>{' '}</>)}</fieldset><button type="submit" class="button top-gap no-print">Check together</button><p id="reading-feedback" class="top-gap micro" role="status"></p><Feedback compact /></form><details class="evidence-card print-answer"><summary>Facilitator’s answer and explanation</summary><div><p>{pack.options[pack.answer]}</p><p>{pack.explanation}</p></div></details></section> <section class="panel panel-body"><h2><span class="prompt-number">2</span> Talk it through</h2> <p>{pack.discussion}</p><p class="micro">An open conversation. Several thoughtful answers may fit, and nobody needs to disclose a private experience.</p><div class="print-lines print-only"></div><button class="button secondary top-gap no-print" data-finish="1" disabled>We discussed it, or chose to pass</button></section> <section class="panel panel-body"><h2><span class="prompt-number">3</span> Try something together</h2> <p>{pack.activity}</p><div class="reading-note"><h3>Close with one thought</h3><p>{pack.close}</p></div> <div class="print-lines print-only"></div><button class="button secondary no-print" data-finish="2" disabled>We tried it, or chose to pass</button></section> <section class="completion" id="session-complete" hidden><div id="session-end"></div></section></div> <aside class="sidebar sticky"><HowItWorks>{' '}<p>Use one shared screen, press Projector for large text, or print the prompts. Anyone may pass, and an adult can adapt the vocabulary.</p><p>About {pack.minutes} minutes. An open conversation has several thoughtful answers, and nobody needs to disclose a private experience.</p><p>No names, ages, answers about family life or child profiles are requested. The age label describes the pack, not a participant.</p></HowItWorks>{' '}<section class="panel panel-body"><h2>This sitting</h2><ol class="stage-track"><li data-step="0">Read</li> <li data-step="1">Discuss</li> <li data-step="2">Try</li></ol><p id="session-count" role="status">0 of 3 steps complete</p><label class="check no-print"><input id="remember-pack" type="checkbox"/>Remember this sitting on this browser for up to 30 days</label> <button class="button secondary top-gap no-print" id="restart-pack">Restart this pack</button></section></aside></div>
 <References sources={pack.sources} commentaryUrl={'commentaryUrl' in pack?pack.commentaryUrl:undefined}/>
 <script id="activity-data" type="application/json" set:html={JSON.stringify(pack).replace(/</g,'\\u003c')}/>
 <script>import '../../lib/library';import '../../lib/session';</script>
</Shell>
