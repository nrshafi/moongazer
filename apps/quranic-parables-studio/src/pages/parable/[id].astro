---
import Shell from '../../layouts/Shell.astro';import {parables} from '../../data/content.json';export function getStaticPaths(){return parables.map(parable=>({params:{id:parable.id},props:{parable}}));}const {parable}=Astro.props;const p=parable.passage;
---
<Shell title={parable.title}><a class="back-link" href="/">← All comparisons</a><section class="intro"><span class="eyebrow">{parable.area} · Quran {p.ref}</span><h1 class="editorial">{parable.title}</h1><p>Begin with the full passage, then use the reading diagram to trace its image or contrast.</p></section><article class="panel bottom-gap"><div class="panel-head"><h2>The passage</h2><a href={p.translationUrl} target="_blank" rel="noopener noreferrer">Read context ↗</a></div><div class="panel-body"><p class="arabic" lang="ar" dir="rtl">{p.arabic}</p><blockquote class="source-quote">{p.translation}</blockquote><p class="micro">Marmaduke Pickthall · Quran {p.ref}</p></div></article><div class="workspace"><section><section class="panel bottom-gap"><div class="panel-head"><h2>Explore the comparison</h2><span class="pill">Reading diagram</span></div><div class="panel-body"><div class="reading-path" role="group" aria-label="Parts of the comparison">{parable.nodes.map((n,i)=><button class="path-node" data-stage={i} aria-pressed={i===0?'true':'false'}><span>{i+1}</span>{n.label}</button>)}</div>{parable.nodes.map((n,i)=><section data-stage-panel={i} class="stage-note"><h3>{n.label}</h3><p>{n.detail}</p></section>)}<p class="micro">An editorial reading aid. Nodes show the named imagery, contrasts, or sequence, not a complete interpretation.</p></div></section><section class="panel panel-body"><span class="eyebrow">Commentary before reflection</span><h2>Read with the source</h2><p>{parable.summary}</p><a href={parable.commentaryUrl} target="_blank" rel="noopener noreferrer">Al-Tafsir al-Muyassar ↗</a>{parable.secondCommentaryUrl&&<p><a href={parable.secondCommentaryUrl} target="_blank" rel="noopener noreferrer">Al-Jalalayn · second commentary ↗</a></p>}<p class="micro">Original concise English paraphrase of the retrieved Arabic commentary.</p><div class="divider"></div><h3>A reflection to try</h3><p>{parable.reflection}</p><label class="field">Your private reading note<textarea id="reflection" rows="4" maxlength="4000" placeholder="What do you notice in the passage?"></textarea></label><p class="micro">Kept in memory for this visit. Copy or download it to keep it.</p><div class="actions"><button class="button secondary" id="copy-note">Copy reading note</button><button class="button secondary" id="download-note">Download note</button></div></section></section><aside class="sidebar"><section class="panel panel-body"><span class="eyebrow">Notice a detail</span><h2>Reading check</h2><p>{parable.question}</p><form id="quiz" data-answer={parable.answer}><fieldset><legend class="sr-only">Choose an answer</legend>{parable.options.map((o,i)=><label class="quiz-option"><input type="radio" name="answer" value={i} required/> {o}</label>)}</fieldset><button class="button top-gap">Check answer</button><p id="feedback" role="status"></p></form></section><section class="panel panel-body"><button class="button secondary wide" data-save={parable.id} aria-pressed="false">Save reading</button><button class="text-button top-gap" data-print>Print reading worksheet</button></section></aside></div><script>import '../../lib/library';import '../../lib/studio';</script></Shell>
<style>.reading-path{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:24px}.path-node{display:grid;justify-items:center;align-content:start;gap:12px;background:var(--surface);border:1px solid var(--line);padding:18px 10px;border-radius:14px;color:var(--ink);font-size:.82rem;min-width:0}.path-node span{display:grid;place-items:center;width:40px;height:40px;border:2px solid var(--accent);border-radius:50%;color:var(--accent-ink)}.path-node[aria-pressed=true]{background:var(--tint);border-color:var(--accent)}.stage-note{border-left:3px solid var(--accent);padding:6px 18px;margin-bottom:20px}.stage-note p{margin:0;color:var(--muted)}@media(max-width:580px){.reading-path{grid-template-columns:1fr}.path-node{display:flex;align-items:center;justify-content:start;text-align:left;padding:12px}}</style>
